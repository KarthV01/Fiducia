DATABASE_URL="file:./dev.db"
PORT=3000
APP_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# Google OAuth for local account sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_COOKIE_SECRET=""

# Public WalletConnect/Reown project ID used by the browser QR/deep-link modal.
# Create one at https://dashboard.reown.com and allowlist your deployed origin.
VITE_WALLETCONNECT_PROJECT_ID=""

# Local Anvil defaults. Run `npm run deploy:local` after `npm run contracts:build`
# to get the contract addresses for these values.
RPC_URL="http://127.0.0.1:8545"
CHAIN_ID=31337
ESCROW_CONTRACT_ADDRESS=""
USDC_CONTRACT_ADDRESS=""

# Anvil account #0 by default. Local development only.
BACKEND_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Private deliverables and trusted publication jobs.
DELIVERABLE_STORAGE_DIR="storage/deliverables"
INTERNAL_JOB_TOKEN=""
ENABLE_SIMULATION_METRICS="true"
ENABLE_MANUAL_FINGERPRINT="false"
FINGERPRINT_WORKER_URL=""

# Local communication anti-spam limits. Use distributed counters for multi-node deployments.
CONNECTION_REQUEST_LIMIT_PER_DAY=50
MESSAGE_LIMIT_PER_MINUTE=60

# Separate YouTube connection (not ordinary app login). Generate the encryption
# key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"
YOUTUBE_TOKEN_ENCRYPTION_KEY=""
YOUTUBE_API_KEY=""

# Provider-neutral creator social connections. Keep the existing YouTube key
# during migration so previously stored YouTube tokens remain decryptable.
# Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEYS="v1:<base64-32-byte-key>"
SOCIAL_TOKEN_ACTIVE_KEY_ID="v1"

INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/oauth/instagram/callback"
INSTAGRAM_API_VERSION=""

X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/oauth/x/callback"
X_MONTHLY_REQUEST_BUDGET=""

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/oauth/tiktok/callback"

# Separate from the legacy /api/youtube/callback during migration.
YOUTUBE_SOCIAL_REDIRECT_URI="http://localhost:3000/api/oauth/youtube/callback"

# Base Sepolia/Mainnet examples. See docs/base-deployment.md before using real funds.
# Base Sepolia: CHAIN_ID=84532, USDC_CONTRACT_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
# Base Mainnet: CHAIN_ID=8453, USDC_CONTRACT_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
# DEPLOYER_PRIVATE_KEY=""
# BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
# BASE_MAINNET_RPC_URL="https://mainnet.base.org"
# DEMO_BRAND_WALLET_ADDRESS=""
# DEMO_CREATOR_MAYA_WALLET_ADDRESS=""
# SPONSOR_WALLET_ADDRESS=""
# READINESS_TOTAL_CAP_AMOUNT=""
