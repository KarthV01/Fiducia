generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agreement {
  id                    String              @id @default(cuid())
  title                 String?
  deliverableDescription String
  deadline              DateTime
  measurementWindowDays Int
  totalCapAmount        String
  tokenAddress          String?
  status                String              @default("draft")
  termsHash             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  participants          Participant[]
  metrics               Metric[]
  payouts               Payout[]
  observations          MetricObservation[]
  blockchainRecord      BlockchainRecord?
  contractInvite        ContractInvite?
  deliverableSubmissions DeliverableSubmission[]
}

model DeliverableSubmission {
  id               String                @id
  agreementId      String
  creatorProfileId String
  version          Int
  status           String                @default("submitted")
  proofUrl         String
  notes            String?
  contentHash      String
  submittedAt      DateTime              @default(now())
  isLate           Boolean               @default(false)
  approvedTxHash   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  agreement        Agreement             @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  evidence         DeliverableEvidence[]
  reviews          DeliverableReview[]

  @@unique([agreementId, version])
  @@index([agreementId, status])
}

model DeliverableEvidence {
  id           String                @id @default(cuid())
  submissionId String
  url          String
  label        String?
  position     Int
  createdAt    DateTime              @default(now())

  submission   DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
}

model DeliverableReview {
  id               String                @id @default(cuid())
  submissionId     String
  sponsorProfileId String
  decision         String
  comment          String?
  approvalTxHash   String?
  reviewedAt       DateTime              @default(now())

  submission       DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, reviewedAt])
}

model Participant {
  id            String    @id @default(cuid())
  agreementId   String
  role          String
  walletAddress String
  handle        String?
  displayName   String?
  createdAt     DateTime  @default(now())

  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, role])
}

model Metric {
  id           String              @id @default(cuid())
  agreementId  String
  key          String
  label        String?
  createdAt    DateTime            @default(now())

  agreement    Agreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  conditions   Condition[]
  observations MetricObservation[]

  @@unique([agreementId, key])
}

model Condition {
  id        String  @id @default(cuid())
  payoutId  String  @unique
  metricId  String
  operator  String
  threshold String

  payout    Payout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  metric    Metric  @relation(fields: [metricId], references: [id], onDelete: Restrict)
}

model Payout {
  id             String     @id @default(cuid())
  agreementId    String
  kind           String
  label          String
  amount         String
  status         String     @default("pending")
  releasedAt     DateTime?
  releasedTxHash String?
  createdAt      DateTime   @default(now())

  agreement      Agreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  condition      Condition?
}

model MetricObservation {
  id          String    @id @default(cuid())
  agreementId String
  metricId    String
  value       String
  source      String
  observedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  metric      Metric    @relation(fields: [metricId], references: [id], onDelete: Restrict)
}

model BlockchainRecord {
  id             String    @id @default(cuid())
  agreementId    String    @unique
  chainId        Int
  escrowAddress  String
  agreementKey   String
  tokenAddress   String
  totalCapAmount String
  termsHash      String
  createTxHash   String
  createdAt      DateTime  @default(now())

  agreement      Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  googleSub      String?          @unique
  name           String?
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sessions       AuthSession[]
  sponsors       SponsorProfile[]
  creators       CreatorProfile[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SponsorProfile {
  id                  String           @id @default(cuid())
  userId              String
  name                String
  handle              String           @unique
  walletAddress       String           @unique
  industry            String
  websiteUrl          String?
  logoUrl             String?
  monthlyBudgetAmount String           @default("0")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractInvites     ContractInvite[]
}

model CreatorProfile {
  id              String           @id @default(cuid())
  userId          String
  handle          String           @unique
  displayName     String
  walletAddress   String           @unique
  channelUrl      String?
  category        String
  averageViews    Int              @default(0)
  audience        String?
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractInvites ContractInvite[]
}

model ProfileWallet {
  id            String    @id @default(cuid())
  profileType   String
  profileId     String
  walletAddress String    @unique
  privateKey    String
  provisionedAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([profileType, profileId])
}

model ContractInvite {
  id               String         @id @default(cuid())
  sponsorProfileId String
  creatorProfileId String
  agreementId      String         @unique
  status           String         @default("pending")
  acceptedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sponsorProfile   SponsorProfile @relation(fields: [sponsorProfileId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  agreement        Agreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

// Legacy local demo data is retained so additive schema updates never drop it.
model DemoBrand {
  id                  String   @id
  name                String
  handle              String   @unique
  walletAddress       String   @unique
  industry            String
  websiteUrl          String?
  logoUrl             String?
  monthlyBudgetAmount String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())
}

model DemoCreator {
  id            String   @id
  handle        String   @unique
  displayName   String
  walletAddress String   @unique
  channelUrl    String?
  category      String
  averageViews  Int
  audience      String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}
