generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agreement {
  id                    String              @id @default(cuid())
  title                 String?
  deliverableDescription String
  deadline              DateTime
  measurementWindowDays Int
  totalCapAmount        String
  tokenAddress          String?
  status                String              @default("draft")
  termsHash             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  participants          Participant[]
  metrics               Metric[]
  payouts               Payout[]
  observations          MetricObservation[]
  blockchainRecord      BlockchainRecord?
  contractInvite        ContractInvite?
  deliverableSubmissions DeliverableSubmission[]
  uploadSessions         UploadSession[]
  publications           Publication[]
  performanceRules       PerformanceRule[]
  chainOperations        ChainOperation[]

  basePayoutAmount       String?
  performancePoolAmount  String?
  promoRequirements      String?
  finalCutRequirements   String?
  publicationRequirements String?
  publicationDeadline    DateTime?
  retentionDays          Int                  @default(7)
}

model UploadSession {
  id               String   @id
  agreementId      String
  creatorProfileId String
  checkpoint       String
  status           String   @default("uploading")
  fileName         String
  mimeType         String
  totalSize        String
  receivedSize     String   @default("0")
  storageKey       String
  sha256           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agreement        Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  submission       DeliverableSubmission?

  @@index([agreementId, status])
}

model DeliverableSubmission {
  id               String                @id
  agreementId      String
  creatorProfileId String
  version          Int
  status           String                @default("submitted")
  proofUrl         String?
  checkpoint       String                @default("promo")
  uploadId         String?               @unique
  notes            String?
  contentHash      String
  submittedAt      DateTime              @default(now())
  isLate           Boolean               @default(false)
  approvedTxHash   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  agreement        Agreement             @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  upload            UploadSession?        @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  evidence         DeliverableEvidence[]
  reviews          DeliverableReview[]

  @@unique([agreementId, checkpoint, version])
  @@index([agreementId, status])
}

model Publication {
  id               String   @id @default(cuid())
  agreementId      String
  method           String
  status           String   @default("pending")
  youtubeVideoId   String?
  youtubeUrl       String?
  channelId        String?
  artifactHash     String
  approvedArtifactId String
  idempotencyKey   String   @unique
  fingerprintScore Float?
  fingerprintVersion String?
  visibility       String?
  viewCount        String?
  consecutiveConfirmations Int @default(0)
  requirementsCompliant Boolean?
  publishedAt      DateTime?
  verifiedAt       DateTime?
  retentionStartedAt DateTime?
  measurementEndsAt DateTime?
  lastCheckedAt    DateTime?
  failureReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agreement        Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, status])
}

model YouTubeConnection {
  id                    String   @id @default(cuid())
  creatorProfileId      String   @unique
  channelId             String?
  encryptedRefreshToken String?
  oauthState            String   @unique
  oauthStateExpiresAt   DateTime
  connectedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
}

model PerformanceRule {
  id                    String   @id @default(cuid())
  agreementId           String
  kind                  String
  threshold             String?
  amount                String?
  startsAtViews         String?
  amountPerThousandViews String?
  maximumAmount         String?
  releasedAmount        String   @default("0")
  createdAt             DateTime @default(now())

  agreement             Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model ChainOperation {
  id          String   @id
  agreementId String
  kind        String
  idempotencyKey String @unique
  status      String   @default("pending")
  payloadJson String
  txHash      String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, status])
}

model DeliverableEvidence {
  id           String                @id @default(cuid())
  submissionId String
  url          String
  label        String?
  position     Int
  createdAt    DateTime              @default(now())

  submission   DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
}

model DeliverableReview {
  id               String                @id @default(cuid())
  submissionId     String
  sponsorProfileId String
  decision         String
  comment          String?
  failedCriteriaJson String?
  approvalTxHash   String?
  reviewedAt       DateTime              @default(now())

  submission       DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, reviewedAt])
}

model Participant {
  id            String    @id @default(cuid())
  agreementId   String
  role          String
  walletAddress String
  handle        String?
  displayName   String?
  createdAt     DateTime  @default(now())

  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, role])
}

model Metric {
  id           String              @id @default(cuid())
  agreementId  String
  key          String
  label        String?
  createdAt    DateTime            @default(now())

  agreement    Agreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  conditions   Condition[]
  observations MetricObservation[]

  @@unique([agreementId, key])
}

model Condition {
  id        String  @id @default(cuid())
  payoutId  String  @unique
  metricId  String
  operator  String
  threshold String

  payout    Payout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  metric    Metric  @relation(fields: [metricId], references: [id], onDelete: Restrict)
}

model Payout {
  id             String     @id @default(cuid())
  agreementId    String
  kind           String
  label          String
  amount         String
  status         String     @default("pending")
  releasedAt     DateTime?
  releasedTxHash String?
  createdAt      DateTime   @default(now())

  agreement      Agreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  condition      Condition?
}

model MetricObservation {
  id          String    @id @default(cuid())
  agreementId String
  metricId    String
  value       String
  source      String
  observedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  metric      Metric    @relation(fields: [metricId], references: [id], onDelete: Restrict)
}

model BlockchainRecord {
  id             String    @id @default(cuid())
  agreementId    String    @unique
  chainId        Int
  escrowAddress  String
  agreementKey   String
  tokenAddress   String
  totalCapAmount String
  termsHash      String
  createTxHash   String
  createdAt      DateTime  @default(now())

  agreement      Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model User {
  id             String           @id @default(cuid())
  email          String?          @unique
  googleSub      String?          @unique
  name           String?
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sessions       AuthSession[]
  sponsors       SponsorProfile[]
  creators       CreatorProfile[]
  socialIdentities SocialIdentity[]
  authIdentities  AuthIdentity[]
  walletChallenges WalletChallenge[]
}

model AuthIdentity {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerSubject String
  email           String?
  walletAddress   String?  @unique
  lastChainId     Int?
  verifiedAt      DateTime @default(now())
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider, revokedAt])
}

model WalletChallenge {
  id          String    @id @default(cuid())
  purpose     String
  address     String
  chainId     Int
  nonce       String
  messageHash String
  userId      String?
  profileId   String?
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address, createdAt])
  @@index([expiresAt, usedAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SponsorProfile {
  id                  String           @id @default(cuid())
  userId              String
  name                String
  handle              String           @unique
  walletAddress       String           @unique
  industry            String
  websiteUrl          String?
  logoUrl             String?
  monthlyBudgetAmount String           @default("0")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractInvites     ContractInvite[]
  socialIdentity      SocialIdentity?
}

model CreatorProfile {
  id              String           @id @default(cuid())
  userId          String
  handle          String           @unique
  displayName     String
  walletAddress   String           @unique
  channelUrl      String?
  category        String
  averageViews    Int              @default(0)
  audience        String?
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractInvites ContractInvite[]
  youtubeConnection YouTubeConnection?
  socialIdentity    SocialIdentity?
}

model SocialIdentity {
  id                    String   @id @default(cuid())
  userId                String
  profileType           String
  sponsorProfileId      String?  @unique
  creatorProfileId      String?  @unique
  handle                String
  displayName           String
  avatarUrl             String?
  descriptor            String?
  searchText            String
  readReceiptsEnabled   Boolean  @default(true)
  typingIndicatorsEnabled Boolean @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorProfile        SponsorProfile? @relation(fields: [sponsorProfileId], references: [id], onDelete: Cascade)
  creatorProfile        CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  requestedConnections  Connection[]    @relation("ConnectionRequester")
  receivedConnections   Connection[]    @relation("ConnectionRecipient")
  blocksCreated         ProfileBlock[]  @relation("Blocker")
  blocksReceived        ProfileBlock[]  @relation("Blocked")
  conversationsCreated  Conversation[]  @relation("ConversationCreator")
  conversationMemberships ConversationParticipant[]
  messagesSent          Message[]
  messageReactions      MessageReaction[]
  messageAttachments    MessageAttachment[]
  reportsFiled          ProfileReport[] @relation("ReportAuthor")
  reportsReceived       ProfileReport[] @relation("ReportTarget")

  @@unique([profileType, handle])
  @@index([userId])
  @@index([profileType, displayName])
  @@index([handle])
}

model Connection {
  id          String   @id @default(cuid())
  pairKey     String   @unique
  requesterId String
  recipientId String
  status      String   @default("pending")
  note        String?
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   SocialIdentity @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   SocialIdentity @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId, status, updatedAt])
  @@index([recipientId, status, updatedAt])
}

model ProfileBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   SocialIdentity @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   SocialIdentity @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Conversation {
  id              String   @id @default(cuid())
  type            String
  title           String?
  directPairKey   String?  @unique
  createdById     String
  lastMessageAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy       SocialIdentity @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants    ConversationParticipant[]
  messages        Message[]
  attachments     MessageAttachment[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id              String   @id @default(cuid())
  conversationId  String
  identityId      String
  role            String   @default("member")
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  lastReadAt      DateTime?
  archivedAt      DateTime?
  starredAt       DateTime?
  mutedUntil      DateTime?
  draftText       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  identity        SocialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([conversationId, identityId])
  @@index([identityId, leftAt, archivedAt])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String
  type            String   @default("user")
  body            String?
  replyToId       String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          SocialIdentity @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo         Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[] @relation("MessageReplies")
  reactions       MessageReaction[]
  attachments     MessageAttachment[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
}

model MessageReaction {
  id          String   @id @default(cuid())
  messageId   String
  identityId  String
  emoji       String
  createdAt   DateTime @default(now())

  message     Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  identity    SocialIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([messageId, identityId, emoji])
  @@index([messageId])
}

model MessageAttachment {
  id              String   @id
  conversationId  String
  uploaderId      String
  messageId       String?
  status          String   @default("uploading")
  fileName        String
  mimeType        String
  totalSize       Int
  receivedSize    Int      @default(0)
  storageKey      String
  sha256          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploader        SocialIdentity @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message         Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([messageId])
}

model ProfileReport {
  id          String   @id @default(cuid())
  reporterId  String
  targetId    String
  messageId   String?
  reason      String
  details     String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter    SocialIdentity @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  target      SocialIdentity @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([targetId, status])
}

model ProfileWallet {
  id            String    @id @default(cuid())
  profileType   String
  profileId     String
  walletAddress String    @unique
  privateKey    String
  provisionedAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([profileType, profileId])
}

model ContractInvite {
  id               String         @id @default(cuid())
  sponsorProfileId String
  creatorProfileId String
  agreementId      String         @unique
  status           String         @default("pending")
  acceptedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sponsorProfile   SponsorProfile @relation(fields: [sponsorProfileId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  agreement        Agreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

// Legacy local demo data is retained so additive schema updates never drop it.
model DemoBrand {
  id                  String   @id
  name                String
  handle              String   @unique
  walletAddress       String   @unique
  industry            String
  websiteUrl          String?
  logoUrl             String?
  monthlyBudgetAmount String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())
}

model DemoCreator {
  id            String   @id
  handle        String   @unique
  displayName   String
  walletAddress String   @unique
  channelUrl    String?
  category      String
  averageViews  Int
  audience      String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}
