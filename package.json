{
  "name": "ytpayouts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "anvil": "anvil",
    "db:init": "tsx scripts/initDb.ts",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "deploy:local": "tsx scripts/deployLocal.ts",
    "verify:local-flow": "tsx scripts/verifyLocalFlow.ts",
    "deploy:base-sepolia": "tsx scripts/deployBase.ts base-sepolia",
    "deploy:base-mainnet": "tsx scripts/deployBase.ts base-mainnet",
    "check:base-sepolia": "tsx scripts/checkBaseReadiness.ts base-sepolia",
    "check:base-mainnet": "tsx scripts/checkBaseReadiness.ts base-mainnet",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "viem": "^2.21.53",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
